Options -MultiViews -Indexes
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml .html .htm .css .js .json

DirectoryIndex index.html

RewriteEngine On

# llms.txt отдаём через PHP — иначе Apache теряет UTF-8 в заголовке
RewriteRule ^llms\.txt$ /llms.php [L]

# Страницы лежат каталогами: /cases → /cases/index.html без 301 на слэш.
# Так живой URL совпадает с canonical и sitemap.xml.
# DOCUMENT_ROOT на Beget не совпадает с реальным путём, поэтому проверяем
# существование файла через REQUEST_FILENAME
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# Несуществующий адрес отдаёт честный 404, а не главную со статусом 200
ErrorDocument 404 /404.html
